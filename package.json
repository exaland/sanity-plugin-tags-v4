{
  "name": "sanity-plugin-tags-v4",
  "version": "1.0.25",
  "description": "A multi-tag input for Sanity Studio",
  "keywords": [
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/exaland/sanity-plugin-tags-v4#readme",
  "bugs": {
    "url": "https://github.com/exaland/sanity-plugin-tags-v4/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/exaland/sanity-plugin-tags-v4.git"
  },
  "license": "MIT",
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.esm.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.esm.d.ts",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run-s clean && tsc -p tsconfig.dist.json && pkg-utils build --strict && plugin-kit verify-package --silent",
    "clean": "rimraf dist",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "watch": "pkg-utils watch --strict",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tsdown/css": "^0.23.4",
    "react-select": "^5.10.2"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/plugin-kit": "^10.0.12",
    "@types/react": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "latest",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "rimraf": "^6.1.3",
    "rollup-plugin-postcss": "^4.0.2",
    "rxjs": "^7.8.2",
    "typescript": "latest"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.18.0",
    "styled-components": "^6.1.0"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "authors": [
    "Alexandre Magnier | Exaland Concept <exaland@gmail.com>",
    "P Christopher Bowers <pcbowers@gmail.com>",
    "Leo Baker-Hytch <l.bakerhytch@gmail.com>"
  ],
  "overrides": {
    "esbuild": "latest",
    "serialize-javascript": "^7.0.5"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "tsc": true,
      "tsconfig": false,
      "scripts": false,
      "esmOnly": false,
      "bannedFiles": false,
      "eslintImports": false,
      "oxlint": false,
      "oxfmt": false,
      "oxfmtCheck": false,
      "oxlintCheck": false,
      "prettierCheck": false,
      "prettier": false
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.esm.js",
      "./package.json": "./package.json"
    }
  },
  "inlinedDependencies": {
    "@sanity/ui": "4.4.10",
    "react-is": "19.3.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  }
}
